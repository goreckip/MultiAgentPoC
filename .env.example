OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMA_PERSIST_DIR=data/chroma
CONFIDENCE_THRESHOLD=0.6

# Langfuse Cloud (free/Hobby tier) — create a project at cloud.langfuse.com and
# paste its keys here. Use https://us.cloud.langfuse.com if your project is on the US region.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Local ClamAV (portable install, not checked into git — see docs/decision_log.md
# for setup). Defaults resolve to .clamav/clamav-1.5.4.win.x64/ under the repo
# root; only set these if your install lives somewhere else.
# CLAMSCAN_PATH=
# CLAMAV_DB_PATH=
MAX_ATTACHMENT_SIZE_BYTES=10485760
